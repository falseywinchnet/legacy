+      subroutine  chk_vdatum_unitsys(stdout, vdatum, unitsys, source)
+
+c     Check that the value of vdatum and unitsys matches what  
+c     has been set in the global values.
+
+      implicit none
+
+      integer stdout
+
+      character*8 vdatum, unitsys
+      character*(*) source
+
+      include 'grid_datum.cmn'
+
+c     ******************************formats*****************************
+50    format(/,'*ERR:XXX* Required vertical datum is: ',a,
+     a      ' but vertical datum: ',a,' found ',a)
+52    format(/,'*ERR:XXX* Required unit system is: ',a,
+     a      ' but unit system: ',a,' found ',a)
+c     ******************************************************************
+      if(g_vdatum /= 'NONE') then
+c       Every value of vdatum must agree with g_vdatum unless it has 
+c       been called not applicable  
+        if(vdatum /= 'NA') then
+          if(vdatum /= g_vdatum ) then
+            write(stdout,50) g_vdatum, vdatum, source
+            stop 'Abnormal stop: Vertical datum error'
+          endif
+        endif
+      endif
+      if(g_unitsys /= 'NONE') then
+c       Every value of unitsys must agree with g_unitsys unless it has
+c       been called not applicable  
+        if(unitsys /= 'NA') then
+          if(unitsys /= g_unitsys) then
+            write(stdout,52) g_unitsys, unitsys, source
+            stop 'Abnormal stop: Unit system error'
+          endif
+        endif
+      endif
+      return
+      end
