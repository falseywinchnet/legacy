+      SUBROUTINE PUT_chr8_IN_FT(FTP, STRING)
+
+C     Put the characters in STRING into a function-table header block
+C     with the first character being stored in the first byte of 
+C     the four-byte word at FTP.  STRING is of fixed length.
+
+      IMPLICIT NONE
+      CHARACTER*8 STRING
+
+      INTEGER FTP
+
+      INCLUDE 'arsize.prm'
+      INCLUDE 'ftable.cmn'
+
+C     Local
+
+      CHARACTER  CS8*8
+      REAL*4 SP(2)
+      REAL*8 DP
+
+      REAL*8 CHAR_TO_DP
+
+      EQUIVALENCE (SP(1), DP)
+C***********************************************************************
+      CS8 = STRING(1:8)
+      DP = CHAR_TO_DP(CS8)
+      FTAB(FTP) = SP(1)
+      FTAB(FTP+1) = SP(2)
+      RETURN
+      END
+
