+      subroutine get_east_north(
+     i                        stdout, tabadrs,
+     o                        easting, northing)
+
+c     Get the easting and northing values from a function table.
+      implicit none
+
+      integer stdout, tabadrs
+      real*8 easting, northing
+
+      integer gettbn, gettyp
+      real*8 get_dp_from_ft
+      character*16 get_tabid
+      external get_dp_from_ft, get_tabid, gettbn, gettyp
+
+c     Local
+      integer type
+c     **********************Formats*************************************
+50    format(/,'*BUG* Table id=',a,' has invalid type=',i7,
+     a         ' in subroutine get_east_north')
+c***********************************************************************
+      type = gettyp(tabadrs)
+      select case(type)
+
+      case default
+        write(stdout,50) get_tabid(gettbn(tabadrs)), type
+        stop 'Abnormal stop.  Bug found'
+
+      case(2,3,4,7,8,9,11)
+c       These are one-d function tables.
+        easting = get_dp_from_ft(tabadrs+14)
+        northing = get_dp_from_ft(tabadrs+16)
+
+      case(6,10,13,14,43)
+c       These are two-d function tables:  6, 10,13,14 are
+c       created manually or by fequtl.  43 is from conversion
+c       right after input. 
+        easting = get_dp_from_ft(tabadrs+20)
+        northing = get_dp_from_ft(tabadrs+22)
+
+      case(20,21,22,23,24,25,
+     a     30,31,32,33,34,35)
+c       20-25 are for cross-section function tables as input. 
+c       Types 30-35 are  generated internally on user option
+c       immediately after input of types 20-25
+        easting = get_dp_from_ft(tabadrs+8)
+        northing = get_dp_from_ft(tabadrs+10)
+ 
+      end select 
+      return
+      end      
+c
+c 
+c 
+      subroutine put_east_north(
+     i                        stdout, tabadrs, 
+     i                        easting, northing)
+
+c     Put the easting and northing values into a function table.
+      implicit none
+
+      integer stdout, tabadrs
+      real*8 easting, northing
+
+      integer gettbn, gettyp
+      character*16 get_tabid
+      external put_dp_in_ft, get_tabid, gettbn, gettyp
+
+c     Local
+      integer type
+c     **********************Formats*************************************
+50    format(/,'*BUG* Table id=',a,' has invalid type=',i7,
+     a         ' in subroutine put_east_north')
+
+c***********************************************************************
+      type = gettyp(tabadrs)
+      select case(type)
+
+      case default
+        write(stdout,50) get_tabid(gettbn(tabadrs)), type
+        stop 'Abnormal stop.  Bug found'
+
+      case(2,3,4,7,8,9,11)
+c       These are one-d function tables.
+        call put_dp_in_ft(tabadrs+14, easting)
+        call put_dp_in_ft(tabadrs+16, northing)
+
+      case(6,10,13,14,43)
+c       These are two-d function tables:  6, 10,13,14 are
+c       created manually or by fequtl.  43 is from conversion
+c       right after input. 
+        call put_dp_in_ft(tabadrs+20, easting)
+        call put_dp_in_ft(tabadrs+22, northing)
+
+      case(20,21,22,23,24,25,
+     a     30,31,32,33,34,35)
+c       20-25 are for cross-section function tables as input. 
+c       Types 30-35 are  generated internally on user option
+c       immediately after input of types 20-25
+        call put_dp_in_ft(tabadrs+8, easting)
+        call put_dp_in_ft(tabadrs+10, northing)
+ 
+      end select 
+      return
+      end      
+c
+c 
+c 
+      subroutine put_location_1dtab(
+     i     adrs, zone, hgrid, vdatum, unitsys, basis, easting, northing)
+      
+c     Store the location, datum, basis information in a one-d table.
+
+      implicit none
+
+      INCLUDE 'arsize.prm'
+      INCLUDE 'ftable.cmn'
+
+      integer adrs
+      real*8 easting, northing
+      character*8 zone, hgrid, vdatum, unitsys, basis
+
+c     External program units
+      External put_chr8_in_ft, put_dp_in_ft
+c     ******************************************************************
+c     Store the zone, grid, datum, and unitsys information
+      call put_chr8_in_ft(adrs+6, zone)
+      call put_chr8_in_ft(adrs+8, hgrid)
+      call put_chr8_in_ft(adrs+10, vdatum)
+      call put_chr8_in_ft(adrs+12, unitsys)
+      call put_chr8_in_ft(adrs+20, basis)
+      CALL PUT_DP_IN_FT(adrs+14, EASTING)
+      CALL PUT_DP_IN_FT(adrs+16, NORTHING)
+      return
+      end
+c
