+50    format(/,' FEQ found ',i5,' tables for the function-table index.')
+52    format(' Function-table index for the current scenario.')
+54    format( 'TABID',11x,1x,' Type',2x,'File name for the table')
+56    format(a16,1x,i5,2x,a)
