+      subroutine get_zone_etc(
+     i                        stdout, tabadrs,
+     o        zone, hgrid, vdatum, unitsys, basis)
+
+c     Get the zone... info from a function table.
+
+      implicit none
+
+      integer stdout, tabadrs
+      character*8 zone, hgrid, vdatum, unitsys, basis
+     
+      integer gettbn, gettyp
+      character*8 get_chr8_from_ft
+      character*16 get_tabid
+      external get_chr8_from_ft, get_tabid, gettbn, gettyp
+      
+c     Local
+      integer ip, type
+c     **********************Formats*************************************
+50    format(/,'*BUG* Table id=',a,' has invalid type=',i7,
+     a         ' in subroutine get_zone_etc')
+c***********************************************************************
+      ip = tabadrs
+      type = gettyp(ip)
+      select case(type)
+
+      case default
+        write(stdout,50) get_tabid(gettbn(tabadrs)), type
+        stop 'Abnormal stop.  Bug found'
+
+      case(2,3,4,7,8,9,11)
+c       These are one-d function tables.
+        zone = GET_chr8_FROM_FT(ip+6)   
+        hgrid = GET_chr8_FROM_FT(ip+8)  
+        vdatum = GET_chr8_FROM_FT(ip+10) 
+        unitsys = GET_chr8_FROM_FT(ip+12)
+        basis = GET_chr8_FROM_FT(ip+20)  
+
+      case(6,10,13,14,43)
+c       These are two-d function tables:  6, 10,13,14 are
+c       created manually or by fequtl.  43 is from conversion
+c       right after input in feq. 
+        zone = GET_chr8_FROM_FT(ip+12)   
+        hgrid = GET_chr8_FROM_FT(ip+14)  
+        vdatum = GET_chr8_FROM_FT(ip+16) 
+        unitsys = GET_chr8_FROM_FT(ip+18)
+        basis = GET_chr8_FROM_FT(ip+24)  
+
+      case(20,21,22,23,24,25,
+     a     30,31,32,33,34,35)
+c       20-25 are for cross-section function tables as input. 
+c       Types 30-35 are  generated internally on user option
+c       immediately after input of types 20-25.
+        zone = GET_chr8_FROM_FT(ip+22)   
+        hgrid = GET_chr8_FROM_FT(ip+24)  
+        vdatum = GET_chr8_FROM_FT(ip+26) 
+        unitsys = GET_chr8_FROM_FT(ip+28)
+        basis = GET_chr8_FROM_FT(ip+30)  
+
+      end select 
+      return
+      end      
+C
+C
+C
+      INTEGER FUNCTION   GETTYP
+     I                         (ADRS)
+ 
+C     + + + PURPOSE + + +
+C     Get the table type of the table at ADRS.
+ 
+      IMPLICIT NONE
+C     + + + DUMMY ARGUMENTS + + +
+      INTEGER ADRS
+ 
+C     + + +DUMMY ARGUMENT DEFINITIONS + + +
+C     ADRS   - address of the function table in FTAB/ITAB
+ 
+C     + + + COMMON BLOCKS + + +
+      INCLUDE 'arsize.prm'
+      INCLUDE 'ftable.cmn'
+C***********************************************************************
+      GETTYP = ITAB(ADRS+2)
+      RETURN
+      END
