+      SUBROUTINE qsrt_alpha_plus_pointer(a, ap, N)                                                  
+
+c     Use quicker sort to sort the character array, a, into whatever
+c     order Fortran happens to take.  Move the elements of the pointer
+c     array, ap, at the same time, N is the number of elements in
+c     each.  Based on QSORTA-obtained from a collegue more than 30
+c     years ago!
+
+      implicit none                                                                             
+C                
+      integer n
+      character*16 a(n), t, x
+      integer ap(n), tp, xp
+
+C       THE DIMENSIONS FOR LT AND UT HAVE TO BE AT LEAST LOG  N.              
+C                                                           2                 
+C        WAS CHOSEN TO HANDLE N <524288.                                    
+      INTEGER LT(19), UT(19), I, J, K, M, P, Q  
+c***********************************************************************                                   
+C                                                                             
+      J=N                                                                     
+      M=1                                                                     
+      I=1                                                                     
+C                                                                             
+C       IF THIS SEGMENT HAS MORE THAN TWO ELEMENTS  WE SPLIT IT               
+ 10   continue
+      IF (J-I-1) 100,90,15                                                    
+C                                                                             
+C       P IS THE POSITION OF AN ARBITRARY ELEMENT IN THE SEGMENT              
+C       WE CHOOSE THE MIDDLE ELEMENT. UNDER CERTAIN CIRCUMSTANCES             
+C       IT MAY BE ADVANTAGEOUS TO CHOOSE P AT RANDOM.                         
+ 15   continue
