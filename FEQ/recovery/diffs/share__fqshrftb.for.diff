+      SUBROUTINE   LKTSTAB
+     I                  (ADRS, jta, 
+     O                   FUNC, NTAB, PDV)
+ 
+C     + + + PURPOSE + + +
+C     Do function table look up for time-series tables: types
+c     7, 8, 9, and 11.  All use full double precision in order 
+c     to have a precise argument. 
+
+C     Note: Only type 11 need return a value of pdv because that
+c     is the second value.  Other time series do not need a value
+c     of the derivative.  Thus do not comput and return a value of
+c     zero.  Also we still return single precision values--the
+c     use of double precision is only for the benefit of the 
+c     argument. 
+
+      IMPLICIT NONE 
+C     + + + DUMMY ARGUMENTS + + +
+      INTEGER ADRS, NTAB
+      REAL  FUNC, PDV
+      real*8 jta
+ 
+C     + + +DUMMY ARGUMENT DEFINITIONS + + +
+C     ADRS   - address of the function table in FTAB/ITAB/DTAB
+C     jta   - argument for finding values in a function table
+C     FUNC   - value of function found at ARGA
+C     NTAB   - table number
+C     PDV    - partial derivative value
+ 
+C     + + + COMMON BLOCKS + + +
+      INCLUDE 'arsize.prm'
+      INCLUDE 'ftable.cmn'
+      INCLUDE 'xscom.cmn'
+ 
+C     + + + SAVED VALUES + + +
+      INTEGER STEP(11)
+      SAVE STEP
+ 
+C     + + + LOCAL VARIABLES + + +
+      INTEGER HA, INC, LA, LSTA, TYPE
+      REAL*8 A2, A3, ADIFF, AONE, ARG, AZERO, DF, FACT, 
+     a       FONE, FPONE, FPZERO, FZERO, H, P, PH, tp        
+ 
+C     + + + INTRINSICS + + +
+      INTRINSIC ishft
+ 
+
+C     Called subprograms
+      CHARACTER*16 GET_TABID
+      EXTERNAL GET_TABID
+      
+C     + + + DATA INITIALIZATIONS + + +
+      DATA STEP/0,0,0,0,0,0,2,3,3,0,3/
+ 
+C     + + + OUTPUT FORMATS + + +
+ 50   FORMAT(/,'*BUG:XXX* Invalid TYPE=',I5,' in LKTSTAB for TABID=',A)
+ 2000 FORMAT('0','*ERR:70* Argument below range in LKTSTAB',
+     A       /,1X,' Table Id   = ',A,
+     B       /,1X,' Min tab arg           = ',F16.5,
+     C       /,1X,' Arguument      = ',F16.5)
+ 2010 FORMAT('0','*ERR:71* Argument above range in LKTSTAB',
+     A       /,1X,' Table Id   = ',A,
+     B       /,1X,' Max tab arg           = ',F16.5,
+     C       /,1X,' Argument       = ',F16.5)
+C***********************************************************************
+C     HA = HIGH ADDRESS
+C     LA = LOW ADDRESS
+C     ITAB(ADRS+1) = TABLE NUMBER
+C     LSTA = LAST ADDRESS
+ 
+      HA = ITAB(ADRS)
+      LA = (ADRS + OFF234)/2
+      LSTA = ITAB(ADRS+3)
+      TYPE = ITAB(ADRS+2)
+      NTAB = ITAB(ADRS+1)
+      ARG = jta
+      INC = STEP(TYPE)
+ 
+C     INITIALIZE
+ 
+      ADIFF = ARG - dtab(LSTA)
+      IF(ADIFF) 100,300,200
+ 
+C     ARGUMENT PASSED LESS THAN AT PREVIOUS ACCESS TO TABLE
+ 
+ 100  IF( LSTA.GE.LA ) GOTO 110
+ 
+        WRITE(STDOUT,2000) GET_TABID(ITAB(ADRS+1)), dtab(la), ARG
+        EFLAG = 1
+        STOP 'Abnormal stop: errors found.'
+ 
+ 110  IF( ARG.GE.dtab(LSTA) ) GOTO 300
+      LSTA = LSTA - INC
+      GOTO 100
+ 
+C     ARGUMENT PASSED GREATER THAN AT PREVIOUS ACCESS TO TABLE
+ 
+ 200  IF( LSTA.LT.HA ) GOTO 210
+      WRITE(STDOUT,2010) GET_TABID(ITAB(ADRS+1)), dtab(ha), ARG
+      EFLAG = 1
+      LSTA = HA - INC
+      ARG = dtab(HA)
+      GOTO 300
+ 210  IF( ARG.LE.dtab(LSTA+INC) ) GOTO 300
+      LSTA = LSTA + INC
+      GOTO 200
+ 
+ 300  CONTINUE
+ 
+      GOTO (1,1,1,1,1,1,7,8,9,1,11), TYPE
+ 
+ 1    CONTINUE
+        WRITE(STDOUT,50) TYPE, GET_TABID(NTAB)
+        STOP 'Abnormal stop: errors found.'
+ 
+ 7    CONTINUE
+ 
+C     SINGLE FUNCTION - LINEAR INTERPOLATION
+ 
+C       FETCH VALUES FROM DTAB
+ 
+        AZERO = DTAB(LSTA)
+        FZERO = DTAB(LSTA+1)
+        AONE = DTAB(LSTA+2)
+        FONE = DTAB(LSTA+3)
+ 
+C       INTERPOLATE
+ 
+        FACT = (ARG - AZERO)/(AONE - AZERO)
+        FUNC = FZERO + FACT*(FONE - FZERO)
+c        PDV  = (FONE - FZERO)/(AONE - AZERO)
+        pdv = 0.0
+        GOTO 1000
+ 
+C     Dual value- trapezoidal rule interpolation
+ 
+ 8    CONTINUE
+ 
+C       FETCH VALUES
+        AZERO = DTAB(LSTA)
+        FZERO = DTAB(LSTA+1)
+        FPZERO = DTAB(LSTA+2)
+        AONE = DTAB(LSTA+3)
+        FONE = DTAB(LSTA+4)
+        FPONE = DTAB(LSTA+5)
+        PH = ARG - AZERO
+        H = AONE - AZERO
+        P = PH/H
+        tp = FPZERO + P*(FPONE- FPZERO)
+        FUNC = FZERO + 0.5*PH*(FPZERO+ tp)
+        pdv = 0.0
+        GOTO 1000
+ 
+C     HERMITE CUBIC  INTERPOLATION
+ 
+ 9    CONTINUE
+        AZERO = DTAB(LSTA)
+        FZERO = DTAB(LSTA+1)
+        FPZERO = DTAB(LSTA+2)
+        AONE = DTAB(LSTA+3)
+        FONE = DTAB(LSTA+4)
+        FPONE = DTAB(LSTA+5)
+        PH = ARG - AZERO
+        H = AONE - AZERO
+        P = PH/H
+        DF = FONE - FZERO
+        A2 = 3.*DF - H*(FPZERO + FPZERO + FPONE)
+        A3 = H*(FPZERO+FPONE) - 2.*DF
+c        pdv = FPZERO + P*(A2 + A2 + 3.*A3*P)/H
+        FUNC = FZERO + PH*FPZERO + P*P*(A2 + P*A3)
+        pdv = 0.d0
+        GOTO 1000
+ 
 C     TIME SERIES WITH TWO VALUES PER TIME POINT
  
  11   CONTINUE
-        AZERO = FTAB(LSTA)
-        FZERO = FTAB(LSTA+1)
-        FPZERO = FTAB(LSTA+2)
-        AONE = FTAB(LSTA+3)
-        FONE = FTAB(LSTA+4)
-        FPONE = FTAB(LSTA+5)
+        AZERO = DTAB(LSTA)
+        FZERO = DTAB(LSTA+1)
+        FPZERO = DTAB(LSTA+2)
+        AONE = DTAB(LSTA+3)
+        FONE = DTAB(LSTA+4)
+        FPONE = DTAB(LSTA+5)
         PH = ARG- AZERO
         H = AONE - AZERO
         P = PH/H
@@ -2023,7 +3071,7 @@
  
