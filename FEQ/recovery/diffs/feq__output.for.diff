+
+C
+C
+C
+      SUBROUTINE   FND14
+     I                 (STDOUT, QNODE,  EMC, EPT,
+     O                  UEXN, DEXN, HDATUM, EFAC)
+ 
+C     + + + PURPOSE + + +
+C     Find code = 14 with the given flow node, QNODE, and 
+C     return the upstream node, UEXN, downstream node, DEXN,
+C     HDATUM, head datum elevation for flow tables, and EFAC,
+C     the weight factor on elevations.   if not found, 
+C     return -1 in UEXN
+ 
+      IMPLICIT NONE
+C     + + + DUMMY ARGUMENTS + + +
+      INTEGER DEXN, EPT, QNODE, STDOUT,  UEXN
+      INTEGER EMC(EPT)
+
+      REAL HDATUM, EFAC
+ 
+C     + + +DUMMY ARGUMENT DEFINITIONS + + +
+C     STDOUT   - Fortran unit number for user output and messages
+C     UEXN   - upstream exterior node
+C     DEXN   - downstream exterior node number
+C     EMC    - vector containing coded form of the Matrix Control Input
+ 
+C     + + + COMMON BLOCKS + + +
+      INCLUDE 'arsize.prm'
+      INCLUDE 'matcom.cmn'
+ 
+C     + + + LOCAL VARIABLES + + +
+      INTEGER CODE, IENTRY, IDUM, IPNT
+      REAL RDUM
+ 
+C     + + + EXTERNAL FUNCTIONS + + +
+      CHARACTER GETUSN*5
+ 
+C     + + + EXTERNAL NAMES + + +
+      EXTERNAL GETUSN
+
+      EQUIVALENCE (RDUM, IDUM)
+ 
+C     + + + OUTPUT FORMATS + + +
+C***********************************************************************
+C     START SEARCH
+      IENTRY = 0
+ 
+ 100  CONTINUE
+        IENTRY = IENTRY + 1
+        IPNT = ADD(IENTRY)
+        CODE = EMC(IPNT)
+        IF(CODE.EQ.14) THEN
+C         CODE = 14.  Check for flow node
+          IF(QNODE.EQ.EMC(IPNT+3)) THEN
+C           Found match for flow node
+            UEXN = EMC(IPNT+1)
+            DEXN = EMC(IPNT+2)
+            IDUM = EMC(IPNT+8)
+            EFAC = RDUM
+            IDUM = EMC(IPNT+9)
+            HDATUM = RDUM
+            RETURN
+
+          ENDIF
+        ENDIF
+ 
+        IF(CODE.GT.0) THEN
+C         Continue the search.
+          GOTO 100
+        ELSE
+C         End of Network-Matrix Control data.
+          UEXN = -1
+          RETURN
+        ENDIF
+      END
