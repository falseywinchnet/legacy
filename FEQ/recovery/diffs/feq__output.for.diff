+c
+c
+c
+      subroutine find_gate_table_items(std6, ipta, 
+     o           old_lev,            old_lev_offset, 
+     o           control_node_state, control_node_state_offset,
+     o           done)
+
+c     Find the gate_table items that need to be remembered for 
+c     forecast operation.  Give an operation block number location, repeated
+c     calls should return need values for each control node. 
+
+      implicit none
+      integer ipta, old_lev_offset, control_node_state, 
+     a        control_node_state_offset, done, std6
+      real old_lev
+
+c     common blocks
+
+      include 'arsize.prm'
+      include 'ftable.cmn'
+
+c     Local
+
+      integer first, ipt, control_node
+
+      save first, ipt
+
+      data first/1/
+
+c***********************************************************************
+      if(first == 1) then
+c       Setup pointer for loop over control nodes
+        ipt = ipta
+        ipt = ipt + 12
+        first = 0
+      endif
+c     check the next control node.  Note that when we leave the 
+c     subroutine with a value, we must set ipt to the start of
+c     block for the next control node.  
+      control_node = itab(ipt)
+      if(control_node /= 0) then
+c       Get values and return
+        old_lev = ftab(ipt+4)
+        old_lev_offset = ipt+4 - ipta
+
+        control_node_state = itab(ipt+5)
+        control_node_state_offset = ipt+5 - ipta
+c       point to the next control node
+        ipt = ipt + 17
+        done = 0 !not done yet:)
+      else
+c       all control nodes processed
+        done = 1  !done now
+        first = 1 !Reset the first flag for the next control block:)
+      endif  
+
+      return
+      end
 
