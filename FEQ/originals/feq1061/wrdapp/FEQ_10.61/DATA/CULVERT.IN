FEQX
TABLE#= 1003 NEWBETAM SAVE22 NOOUT EXTEND
STATION=     0.000
NAVM=0
NSUB    1     0.080
 OVERLAND FLOW, R.B.
      5.68    679.42    1 RD
      7.0     679.7     1 AP
     17.0     680.2     1 AP
    116.0     683.1     1 AP
    200.0     685.0     1 AP
    320.0     681.1     1 AP
    472.0     687.8    -1 AP
 
 
 
