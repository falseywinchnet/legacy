C     Common block for items needed for creating files for 
C     GENSCN

      INTEGER MNGSOUT, MNGSOUT2
      PARAMETER(MNGSOUT=20000, MNGSOUT2=2*MNGSOUT)

      INTEGER FEO_UNIT, TSD_UNIT, FTF_UNIT, GENSCN_NOUT,
     A        GENSCN_RECORD_KNT 

      INTEGER GENSCN_POUT(MNGSOUT)

      REAL GENSCN_OUT_VEC(MNGSOUT2)

      REAL*8 GENSCN_JTIME

      COMMON/GENSCN/GENSCN_JTIME, FEO_UNIT, TSD_UNIT, FTF_UNIT, 
     A         GENSCN_NOUT, GENSCN_RECORD_KNT,  GENSCN_POUT, 
     B         GENSCN_OUT_VEC

