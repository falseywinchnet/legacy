C     + + + PARAMETERS + + +
      INTEGER    IFLSIZ,        MAXDSS
      PARAMETER (IFLSIZ = 300,MAXDSS = 10)

      INTEGER        DSSOPN(MAXDSS),IFLTAB(IFLSIZ,MAXDSS),
     A           NUMBER_OF_HECDSS_FILES

      CHARACTER*64 DSS_NAME(MAXDSS)

      COMMON /HECDSS/DSSOPN, IFLTAB, NUMBER_OF_HECDSS_FILES

      COMMON /HECDSSC/ DSS_NAME

      SAVE /HECDSS/, /HECDSSC/
