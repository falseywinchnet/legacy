C     COMMON BLOCKS FOR THE TRANSLATION FROM INTERNAL NODE AND BRANCH
C     NUMBERS TO THEIR USER DESIGINATION.  NEED TWO BLOCKS BECAUSE 
C     OF FORTRAN RESTRICTIONS ON CHARACTER VARIABLES IN COMMON WITH
C     NON-CHARACTER VARIABLES.


C     ALSO INCLUDE THE MAPPING VECTOR SO THE OLD STYLE INPUT WILL 
C     OUTPUT EXTERIOR NODES IN ASCENDING NUMERICAL ORDER.

      INTEGER INBRUS(9999), USNSRT(MNEX)

      CHARACTER*5 INENUS(MNEX)

      COMMON/INBR/ INBRUS

      COMMON/INEN/ USNSRT

      COMMON/INENC/ INENUS
C
