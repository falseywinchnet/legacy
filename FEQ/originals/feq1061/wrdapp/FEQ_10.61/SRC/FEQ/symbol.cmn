C     Symbol table for processing FEQ.

      INTEGER MAX_SYMBOL
      PARAMETER (MAX_SYMBOL=250)

      CHARACTER*16 SYMBOL(MAX_SYMBOL)

      INTEGER SYMBOL_CLASS(MAX_SYMBOL), SYMBOL_VALUE(MAX_SYMBOL),
     A        LAST_SYMBOL

      COMMON/SYMBOL_C/ SYMBOL

      COMMON/SYMBOL_I/ SYMBOL_CLASS, SYMBOL_VALUE, LAST_SYMBOL

      SAVE /SYMBOL_C/, /SYMBOL_I/
