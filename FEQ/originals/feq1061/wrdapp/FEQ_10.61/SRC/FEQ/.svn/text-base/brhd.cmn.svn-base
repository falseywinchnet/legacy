      INTEGER MAXR_BRHD, MAXC_BRHD, MAXDP_BRHD
      PARAMETER (MAXR_BRHD=5,  MAXC_BRHD=1, MAXDP_BRHD=1)
      INTEGER BRHDITAB(MAXR_BRHD)
      REAL BRHDFTAB(MAXR_BRHD)
      REAL*8 BRHDDTAB(MAXDP_BRHD)
      CHARACTER*256 BRHDCTAB(MAXC_BRHD)

      COMMON/BRHD_COM/  BRHDDTAB, BRHDITAB, BRHDFTAB

      COMMON/BRHD_COMC/ BRHDCTAB
