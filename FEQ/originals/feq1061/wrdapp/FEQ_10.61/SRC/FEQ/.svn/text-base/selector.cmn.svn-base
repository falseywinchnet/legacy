C     Symbol table for selector processing in FEQ

      INTEGER MAX_SYMBOL
      PARAMETER (MAX_SYMBOL=100)

      CHARACTER*16 SYMBOL(MAX_SYMBOL)

      INTEGER SYMBOL_CLASS(MAX_SYMBOL), SYMBOL_VALUE(MAX_SYMBOL),
     A        LAST_SYMBOL

      COMMON/SELECTOR_C/ SYMBOL

      COMMON/SELECTOR_I/ SYMBOL_CLASS, SYMBOL_VALUE, LAST_SYMBOL

      SAVE /SELECTOR_C/, /SELECTOR_I/
