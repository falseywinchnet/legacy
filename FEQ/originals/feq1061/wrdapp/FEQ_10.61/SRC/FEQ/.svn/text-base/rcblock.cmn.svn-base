      INTEGER MAXR_RC, HMAXR_RC, MAXC_RC
      PARAMETER (MAXR_RC=80, HMAXR_RC=MAXR_RC/2, MAXC_RC=32)
      INTEGER RCBITAB(MAXR_RC)
      REAL RCBFTAB(MAXR_RC)
      REAL*8 RCBDTAB(HMAXR_RC)
      CHARACTER*256 RCBCTAB(MAXC_RC)

      COMMON/RC_COM/ RCBDTAB, RCBITAB, RCBFTAB

      COMMON/RC_COMC/ RCBCTAB
