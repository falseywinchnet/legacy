C     Common block for the structure needed to store output values
C     destined for a DSS file.

      INTEGER MNDSSOUT, MNVALOUT, INTFAC
      PARAMETER(MNDSSOUT=1500, INTFAC=4, MNVALOUT=INTFAC*MNDSSOUT + 1)
      
      INTEGER NDSSOUT, MINUTE_OFFSET(MNDSSOUT+1), 
     A                     VALUE_POINTER(MNDSSOUT+1)

      REAL DSS_OUTPUT_BUFFER(0:MNDSSOUT,MNFOUT), VALOUT(MNVALOUT)

      DOUBLE PRECISION FEQJT(0:MNDSSOUT)

      COMMON/DSSOUT/ FEQJT, NDSSOUT, DSS_OUTPUT_BUFFER,
     A               MINUTE_OFFSET, VALUE_POINTER, VALOUT

      SAVE /DSSOUT/
