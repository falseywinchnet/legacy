C***********************************************************************
      COMMON/WRCOM/ NFOUT, DSS_OUT_COUNT, UNOUT, BRAOUT, NODOUT, ICDOUT,
     A              wr_rec, DSS_INDEX_OUT, DSS_BUFFER_COLUMN, 
     b              TIME_STEP_OUT, IRR_DT, ACTOUT

