     A        ACTOUT(MNFOUT), ICDOUT(MNFOUT), wr_rec(MNFOUT),
     b        DSS_INDEX_OUT(MNFOUT), DSS_BUFFER_COLUMN(MNFOUT), 
     c        TIME_STEP_OUT(MNFOUT)
     
      REAL*8 RUNQUAD(MNFOUT), OLDF(MNFOUT), quadfactor
C***********************************************************************

