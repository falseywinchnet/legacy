C     Common block for extending the special output options

      INTEGER TOTAL_AREA, MAIN_CHANNEL_AREA, FLOOD_PLAIN_AREA,
     A        MEAN_VELOCITY, MAIN_CHANNEL_VELOCITY,
     B        FLOOD_PLAIN_VELOCITY, FLOOD_PLAIN_FLOW,
     C        MAIN_CHANNEL_FLOW, FILL_FACTOR

      PARAMETER (TOTAL_AREA=1, MAIN_CHANNEL_AREA=20, 
     A           FLOOD_PLAIN_AREA=21, MEAN_VELOCITY=2, 
     B           MAIN_CHANNEL_VELOCITY=22, FLOOD_PLAIN_VELOCITY=23, 
     C           FLOOD_PLAIN_FLOW=24, MAIN_CHANNEL_FLOW=25,
     D           FILL_FACTOR=MNSOUT*MNSPROW)


      INTEGER SPOUT_KNT, LINE_KNT, SPOUT_ITEM(MNSPROW),
     A        SPOUT_ITEM_VALUE(MNSPROW), SPOUT_STYLE,
     B        SPOUT_MAIN_CHANNEL_TABLE(MNSOUT), NEED_LOOKUP,
     c        stdspo, spo_knt, stdspout


      CHARACTER  SPOUT_ITEM_NAME(MNSPROW)*8, 
     A           SPOUT_ITEM_LABEL(MNSPROW)*10,
     B           EXTRA_BUFFER(MNSOUT,MNSPROW)*8

      COMMON/SPOUTA/ LINE_KNT, SPOUT_KNT, SPOUT_ITEM, NEED_LOOKUP,
     A               SPOUT_ITEM_VALUE, SPOUT_MAIN_CHANNEL_TABLE,
     B               SPOUT_STYLE, stdspo, spo_knt, stdspout

      COMMON/SPOUTC/ SPOUT_ITEM_LABEL, SPOUT_ITEM_NAME,
     A               EXTRA_BUFFER


      SAVE /SPOUTA/, /SPOUTC/
