C     Data structure for tracking which Fortran I/O units are
C     in use, which should never be used, and which are 
C     available.

      INTEGER MAX_UNIT, DIM_UNIT, FORTRAN_IO, HECDSS_IO
      PARAMETER (MAX_UNIT=1022, DIM_UNIT=MAX_UNIT+2, FORTRAN_IO=1,
     A           HECDSS_IO=2)

      INTEGER UNIT_STATUS(DIM_UNIT), UNIT_KNT

      COMMON/UNIT_COM/ UNIT_KNT, UNIT_STATUS

      SAVE /UNIT_COM/