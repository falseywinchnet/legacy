        Example of an underflow gate table computation.
 
FTABIN
TABLE#=  200
TYPE=   -2
REFL=0.0
     ANLGE        Cc   Tainter gate- Henderson Eq. 6-46
       0.0     1.000
      10.0     0.921
      20.0     0.851
      30.0     0.790
      40.0     0.738
      50.0     0.694
      60.0     0.660
      70.0     0.634
      80.0     0.618
      90.0     0.611
; Extend from log-log fit to von Mises b/B=0 data in Rouse,
;  Elementary Fluid Mechanics, p. 57
    100.0      0.591
    110.0      0.573
    120.0      0.558
    130.0      0.543
    135.0      0.537
     -1.0
TABLE#=  -1
 
;  Approach cross section for the example underflow gate command.
 
FEQX
TABLE#= 1000 OUT22 SAVE22
STATION=     1.00
NAVM=    0
NSUB    1     0.024
    OFFSET ELEVATION SUBS
      0.0      650.0    1
      0.0      449.0
   1200.0      449.0
   1200.0      650.0   -1
 
; Departure section for the example underflow gate command.
 
FEQX
TABLE#= 1002 OUT22 SAVE22
STATION=     1.00
NAVM=    0
NSUB    1     0.024
    OFFSET ELEVATION SUBS
      0.0      650.0    1
      0.0      446.0
   1200.0      446.0
   1200.0      650.0   -1
 
 
