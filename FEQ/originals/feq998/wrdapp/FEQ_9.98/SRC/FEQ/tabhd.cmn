      REAL TABHDFTAB(MAXR_TABHD)
      REAL*8 TABHDDTAB(MAXDP_TABHD)
      CHARACTER*64 TABHDCTAB(MAXC_TABHD)

      COMMON/TABHD_COM/  TABHDDTAB, TABHDITAB, TABHDFTAB

      COMMON/TABHD_COMC/ TABHDCTAB
