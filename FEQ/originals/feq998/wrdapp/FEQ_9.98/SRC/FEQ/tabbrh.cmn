      INTEGER MAXR_TABBRH, MAXC_TABBRH, MAXDP_TABBRH
      PARAMETER (MAXR_TABBRH=2,  MAXC_TABBRH=1, MAXDP_TABBRH=1)
      INTEGER TABBRHITAB(MAXR_TABBRH)
      REAL TABBRHFTAB(MAXR_TABBRH)
      REAL*8 TABBRHDTAB(MAXDP_TABBRH)
      CHARACTER*64 TABBRHCTAB(MAXC_TABBRH)

      COMMON/TABBRH_COM/  TABBRHDTAB, TABBRHITAB, TABBRHFTAB

      COMMON/TABBRH_COMC/ TABBRHCTAB
