#!/bin/sh
set -e
if [ "$1" = configure ]; then
    mkdir -p /usr/share/applications /usr/share/icons/hicolor/scalable/apps
    ln -sf /opt/feq-workbench/bin/feq-workbench /usr/bin/feq-workbench
    ln -sf /opt/feq-workbench/share/applications/feq-workbench.desktop /usr/share/applications/feq-workbench.desktop
    ln -sf /opt/feq-workbench/share/icons/hicolor/scalable/apps/feq-workbench.svg /usr/share/icons/hicolor/scalable/apps/feq-workbench.svg
    if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database -q || true; fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then gtk-update-icon-cache -q /usr/share/icons/hicolor || true; fi
fi
